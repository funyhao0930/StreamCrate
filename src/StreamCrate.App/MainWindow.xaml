                                                            <ItemsStackPanel.ChildrenTransitions>
                                                                <TransitionCollection>
                                                                    <RepositionThemeTransition />
                                                                </TransitionCollection>
                                                            </ItemsStackPanel.ChildrenTransitions>
                                                        </ItemsStackPanel>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

