<Window x:Class="StreamCrate.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="StreamCrate">
  <Grid x:Name="RootGrid" Background="{StaticResource DeepSeaBaseBrush}">
    <NavigationView x:Name="RootNavigation" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" SelectionChanged="NavigationSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="新增下載" Tag="download" Icon="Add" IsSelected="True" />
        <NavigationViewItem Content="下載佇列" Tag="queue" Icon="Download" />
        <NavigationViewItem Content="歷史紀錄" Tag="history" Icon="Clock" />
        <NavigationViewItem Content="設定" Tag="settings" Icon="Setting" />
      </NavigationView.MenuItems>
      <Grid Padding="32" MaxWidth="1120">
        <Grid x:Name="DownloadPanel" RowSpacing="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Spacing="4"><TextBlock Text="新增下載" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="把網址交給 StreamCrate，剩下的交給潮汐佇列。" Opacity="0.7"/></StackPanel>
          <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="True" Severity="Informational" Title="準備中" Message="首次使用時會下載並驗證 yt-dlp 與 FFmpeg。"/>
          <ScrollViewer Grid.Row="2"><StackPanel Spacing="14" Margin="0,18,0,0">
            <TextBox x:Name="UrlBox" Header="影片或播放清單網址" PlaceholderText="貼上網址"/>
            <StackPanel Orientation="Horizontal" Spacing="12"><ComboBox x:Name="CookieBox" Header="登入 Cookie 來源" SelectedIndex="0" Width="220"><ComboBoxItem Content="不使用 Cookie" Tag="none"/><ComboBoxItem Content="Chrome" Tag="chrome"/><ComboBoxItem Content="Edge" Tag="edge"/><ComboBoxItem Content="Firefox" Tag="firefox"/><ComboBoxItem Content="cookies.txt（選取檔案）" Tag="file"/></ComboBox><ComboBox x:Name="FormatBox" Header="格式" SelectedIndex="0" Width="150"><ComboBoxItem Content="MP4"/><ComboBoxItem Content="MP3"/></ComboBox><ComboBox x:Name="QualityBox" Header="畫質" SelectedIndex="0" Width="150"><ComboBoxItem Content="最佳"/><ComboBoxItem Content="2160p"/><ComboBoxItem Content="1440p"/><ComboBoxItem Content="1080p"/><ComboBoxItem Content="720p"/></ComboBox></StackPanel>
            <Button Content="解析網址" HorizontalAlignment="Left" Click="ProbeClicked"/><TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="16"/><Button x:Name="QueueButton" Content="加入下載佇列" HorizontalAlignment="Left" Click="QueueClicked" IsEnabled="False"/>
          </StackPanel></ScrollViewer>
        </Grid>
        <Grid x:Name="QueuePanel" Visibility="Collapsed" RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Spacing="4"><TextBlock Text="下載佇列" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="一次一筆，穩定地把每個工作送到岸上。" Opacity="0.7"/></StackPanel><ScrollViewer Grid.Row="1"><StackPanel x:Name="QueueList" Spacing="10" Margin="0,16,0,0"/></ScrollViewer></Grid>
        <Grid x:Name="HistoryPanel" Visibility="Collapsed" RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Spacing="4"><TextBlock Text="歷史紀錄" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="只有本機保留的、安全去敏後結果。" Opacity="0.7"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,14,0,0"><TextBox x:Name="HistorySearchBox" PlaceholderText="搜尋標題或媒體 ID" Width="300" TextChanged="HistorySearchChanged"/><Button Content="清除全部" Click="ClearHistoryClicked"/></StackPanel><ScrollViewer Grid.Row="2"><StackPanel x:Name="HistoryList" Spacing="10" Margin="0,10,0,0"/></ScrollViewer></Grid>
        <Grid x:Name="SettingsPanel" Visibility="Collapsed" RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Spacing="4"><TextBlock Text="設定" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="這些偏好只會保存在此電腦。" Opacity="0.7"/></StackPanel><StackPanel Grid.Row="1" Spacing="14" Margin="0,18,0,0" MaxWidth="520"><TextBox x:Name="DownloadFolderBox" Header="下載資料夾"/><StackPanel Orientation="Horizontal" Spacing="12"><ComboBox x:Name="DefaultFormatBox" Header="預設格式" Width="180"><ComboBoxItem Content="MP4"/><ComboBoxItem Content="MP3"/></ComboBox><ComboBox x:Name="DefaultQualityBox" Header="預設畫質" Width="180"><ComboBoxItem Content="最佳"/><ComboBoxItem Content="2160p"/><ComboBoxItem Content="1440p"/><ComboBoxItem Content="1080p"/><ComboBoxItem Content="720p"/></ComboBox></StackPanel><ComboBox x:Name="ThemeBox" Header="外觀" Width="180"><ComboBoxItem Content="深海深色"/><ComboBoxItem Content="明亮淺色"/></ComboBox><Button Content="儲存設定" HorizontalAlignment="Left" Click="SaveSettingsClicked"/><TextBlock x:Name="SettingsMessage" Opacity="0.75"/></StackPanel></Grid>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
