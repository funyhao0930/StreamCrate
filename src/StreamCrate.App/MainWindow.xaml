<Window
    x:Class="StreamCrate.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="StreamCrate">
    <Grid x:Name="RootGrid" Background="{ThemeResource AppCanvasBrush}" SizeChanged="RootGridSizeChanged">
        <NavigationView
            x:Name="RootNavigation"
            Background="{ThemeResource AppNavigationBrush}"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="220"
            PaneDisplayMode="Auto"
            SelectionChanged="NavigationSelectionChanged">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Padding="12,8,0,8">
                    <Border Width="26" Height="26" CornerRadius="8" Background="{ThemeResource AppPrimaryBrush}">
                        <TextBlock Text="S" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="StreamCrate" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="新增下載" Tag="download" Icon="Add" IsSelected="True" />
                <NavigationViewItem x:Name="QueueNavigationItem" Content="下載佇列" Tag="queue" Icon="Download" />
                <NavigationViewItem Content="歷史紀錄" Tag="history" Icon="Clock" />
                <NavigationViewItem Content="設定" Tag="settings" Icon="Setting" />
            </NavigationView.MenuItems>

            <Grid Padding="32" MaxWidth="960" HorizontalAlignment="Stretch">
                <Grid.Resources>
                    <DataTemplate x:Key="QueueItemTemplate">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Details}" Foreground="{ThemeResource AppMutedTextBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="取消" Tag="{Binding Id}" Click="CancelJobClicked" Visibility="{Binding CancelVisibility}" />
                                </Grid>
                                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Visibility="{Binding ProgressVisibility}" />
                                <TextBlock Text="{Binding ProgressDetails}" Visibility="{Binding ProgressDetailsVisibility}" FontFamily="Cascadia Mono" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" />
                                <TextBlock Text="{Binding ErrorMessage}" Visibility="{Binding ErrorVisibility}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                    <DataTemplate x:Key="HistoryItemTemplate">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Details}" Foreground="{ThemeResource AppMutedTextBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="開啟資料夾" Tag="{Binding OutputPath}" Click="OpenHistoryFolderClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </Grid.Resources>

                <Grid x:Name="DownloadPanel" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="新增下載" Style="{StaticResource PageTitleTextBlockStyle}" />
                            <TextBlock Text="貼上網址、確認內容，再把它送進本機佇列。" Style="{StaticResource PageSubtitleTextBlockStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource QuietPillBorderStyle}" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing x:Name="ToolProgressRing" Width="14" Height="14" IsActive="True" />
                                <TextBlock x:Name="ToolStatusText" Text="正在準備下載工具" Foreground="{ThemeResource AppMutedTextBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True">
                        <InfoBar.ActionButton>
                            <Button x:Name="RetryToolsButton" Content="重試" Click="RetryToolsClicked" Visibility="Collapsed" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <ScrollViewer Grid.Row="2">
                        <StackPanel Spacing="16" Padding="0,8,0,24">
                            <Border Style="{StaticResource DockBorderStyle}">
                                <Border.Transitions>
                                    <TransitionCollection>
                                        <RepositionThemeTransition />
                                    </TransitionCollection>
                                </Border.Transitions>
                                <StackPanel Spacing="14">
                                    <TextBlock Text="NEW DOWNLOAD" Style="{StaticResource SectionLabelTextBlockStyle}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="UrlBox" Header="影片或播放清單網址" PlaceholderText="貼上 http 或 https 網址" TextChanged="UrlTextChanged" />
                                        <Button x:Name="ProbeButton" Grid.Column="1" Content="解析網址" Style="{StaticResource PrimaryActionButtonStyle}" VerticalAlignment="Bottom" Click="ProbeClicked" IsEnabled="False" />
                                    </Grid>
                                    <StackPanel x:Name="OptionsPanel" Orientation="Horizontal" Spacing="12">
                                        <ComboBox x:Name="CookieBox" Header="登入方式" SelectedIndex="0" Width="230">
                                            <ComboBoxItem Content="不使用 Cookie" Tag="none" />
                                            <ComboBoxItem Content="Chrome" Tag="chrome" />
                                            <ComboBoxItem Content="Edge" Tag="edge" />
                                            <ComboBoxItem Content="Firefox" Tag="firefox" />
                                            <ComboBoxItem Content="cookies.txt（選取檔案）" Tag="file" />
                                        </ComboBox>
                                        <ComboBox x:Name="FormatBox" Header="格式" SelectedIndex="0" Width="160">
                                            <ComboBoxItem Content="MP4" />
                                            <ComboBoxItem Content="MP3" />
                                        </ComboBox>
                                        <ComboBox x:Name="QualityBox" Header="畫質" SelectedIndex="0" Width="160">
                                            <ComboBoxItem Content="最佳" />
                                            <ComboBoxItem Content="2160p" />
                                            <ComboBoxItem Content="1440p" />
                                            <ComboBoxItem Content="1080p" />
                                            <ComboBoxItem Content="720p" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel x:Name="ProbeBusyPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                        <ProgressRing Width="18" Height="18" IsActive="True" />
                                        <TextBlock Text="正在解析網址…" VerticalAlignment="Center" Foreground="{ThemeResource AppMutedTextBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ResolvedResultPanel" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                                <Border.Transitions>
                                    <TransitionCollection>
                                        <EntranceThemeTransition />
                                    </TransitionCollection>
                                </Border.Transitions>
                                <StackPanel Spacing="12">
                                    <TextBlock Text="FOUND" Style="{StaticResource SectionLabelTextBlockStyle}" />
                                    <StackPanel x:Name="SingleResultPanel" Spacing="4">
                                        <TextBlock x:Name="ResultTitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="ResultMetaText" Foreground="{ThemeResource AppMutedTextBrush}" />
                                    </StackPanel>
                                    <StackPanel x:Name="PlaylistResultPanel" Spacing="10" Visibility="Collapsed">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock x:Name="PlaylistTitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock x:Name="PlaylistCountText" Foreground="{ThemeResource AppMutedTextBrush}" />
                                            </StackPanel>
                                            <TextBlock x:Name="SelectedCountText" Grid.Column="1" VerticalAlignment="Center" FontFamily="Cascadia Mono" Foreground="{ThemeResource AppMutedTextBrush}" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="全部選取" Click="SelectAllPlaylistClicked" />
                                            <Button Content="全部取消" Click="ClearPlaylistSelectionClicked" />
                                        </StackPanel>
                                        <ScrollViewer MaxHeight="240">
                                            <ItemsControl x:Name="PlaylistItems">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Padding="0,6" ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock Text="{Binding Media.Title}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Media.Duration}" FontFamily="Cascadia Mono" FontSize="11" Foreground="{ThemeResource AppMutedTextBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button x:Name="QueueButton" Content="加入下載佇列" Style="{StaticResource PrimaryActionButtonStyle}" Click="QueueClicked" IsEnabled="False" />
                                        <Button x:Name="ViewQueueButton" Content="查看下載佇列" Click="ViewQueueClicked" Visibility="Collapsed" />
                                    </StackPanel>
                                    <TextBlock x:Name="QueueFeedbackText" Foreground="{ThemeResource AppSuccessBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="QueuePanel" Visibility="Collapsed" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="下載佇列" Style="{StaticResource PageTitleTextBlockStyle}" />
                        <TextBlock Text="一次一筆，清楚掌握每個工作目前的位置。" Style="{StaticResource PageSubtitleTextBlockStyle}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Padding="0,8,0,24">
                        <StackPanel>
                            <Border x:Name="QueueEmptyState" Style="{StaticResource DockBorderStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="目前沒有下載工作" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="解析一個網址後，就能把影片或播放清單加入這裡。" Style="{StaticResource PageSubtitleTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="QueueList" ItemTemplate="{StaticResource QueueItemTemplate}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="HistoryPanel" Visibility="Collapsed" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="歷史紀錄" Style="{StaticResource PageTitleTextBlockStyle}" />
                        <TextBlock Text="只有本機保留、且已去敏的下載結果。" Style="{StaticResource PageSubtitleTextBlockStyle}" />
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnSpacing="10" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HistorySearchBox" PlaceholderText="搜尋標題或媒體 ID" TextChanged="HistorySearchChanged" />
                        <Button Grid.Column="1" Content="清除全部" Click="ClearHistoryClicked" />
                    </Grid>
                    <ScrollViewer Grid.Row="2" Padding="0,0,0,24">
                        <StackPanel>
                            <Border x:Name="HistoryEmptyState" Style="{StaticResource DockBorderStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="尚無歷史紀錄" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="完成、失敗或取消的下載會出現在這裡。" Style="{StaticResource PageSubtitleTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="HistoryList" ItemTemplate="{StaticResource HistoryItemTemplate}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="SettingsPanel" Visibility="Collapsed" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="設定" Style="{StaticResource PageTitleTextBlockStyle}" />
                        <TextBlock Text="這些偏好只保存在這台電腦。" Style="{StaticResource PageSubtitleTextBlockStyle}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Padding="0,8,0,24">
                        <StackPanel Spacing="14" MaxWidth="560">
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="下載預設" Style="{StaticResource SectionLabelTextBlockStyle}" />
                                    <TextBox x:Name="DownloadFolderBox" Header="下載資料夾" />
                                    <StackPanel x:Name="SettingsOptionsPanel" Orientation="Horizontal" Spacing="12">
                                        <ComboBox x:Name="DefaultFormatBox" Header="預設格式" Width="180">
                                            <ComboBoxItem Content="MP4" />
                                            <ComboBoxItem Content="MP3" />
                                        </ComboBox>
                                        <ComboBox x:Name="DefaultQualityBox" Header="預設畫質" Width="180">
                                            <ComboBoxItem Content="最佳" />
                                            <ComboBoxItem Content="2160p" />
                                            <ComboBoxItem Content="1440p" />
                                            <ComboBoxItem Content="1080p" />
                                            <ComboBoxItem Content="720p" />
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="外觀" Style="{StaticResource SectionLabelTextBlockStyle}" />
                                    <ComboBox x:Name="ThemeBox" Header="主題" Width="180">
                                        <ComboBoxItem Content="深色" />
                                        <ComboBoxItem Content="淺色" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <StackPanel Spacing="8">
                                <Button Content="儲存設定" Style="{StaticResource PrimaryActionButtonStyle}" HorizontalAlignment="Left" Click="SaveSettingsClicked" />
                                <TextBlock x:Name="SettingsMessage" Foreground="{ThemeResource AppMutedTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
