                                                    <TextBlock x:Name="QueueFeedbackText" Margin="0,10,0,0" FontSize="12.5" Foreground="{ThemeResource AppSuccessBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
