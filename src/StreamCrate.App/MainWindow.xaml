                                                                    <Ellipse Width="10" Height="10" Fill="#E8F0F2" VerticalAlignment="Center" />
                                                                    <TextBlock Text="淺色" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SettingsGroupBorderStyle}">
                                                <Grid Padding="0,18" ColumnSpacing="26">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="動效速度" Style="{StaticResource UtilityTextBlockStyle}" FontWeight="SemiBold" CharacterSpacing="100" Foreground="{ThemeResource AppFaintTextBrush}" VerticalAlignment="Center" />
                                                    <ComboBox x:Name="MotionTempoBox" Grid.Column="1" Width="180" HorizontalAlignment="Left" SelectedIndex="1" Style="{StaticResource CompactComboBoxStyle}" SelectionChanged="SettingsSelectionChanged">
                                                        <ComboBoxItem Content="快速 · 0.75×" />
                                                        <ComboBoxItem Content="標準 · 1.00×" />
                                                        <ComboBoxItem Content="舒緩 · 1.25×" />
                                                    </ComboBox>
                                                </Grid>
                                            </Border>
                                            <Grid Padding="0,18,0,20" ColumnSpacing="26">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="自訂背景" Style="{StaticResource UtilityTextBlockStyle}" FontWeight="SemiBold" CharacterSpacing="100" Foreground="{ThemeResource AppFaintTextBrush}" Margin="0,3,0,0" />
                                                <Grid Grid.Column="1" ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="128" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Width="128"
                                                        Height="72"
                                                        VerticalAlignment="Top"
                                                        Background="{ThemeResource AppSurfaceSubtleBrush}"
                                                        BorderBrush="{ThemeResource AppBorderStrongBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9">
                                                        <TextBlock Text="背景圖&#10;未選擇" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource UtilityTextBlockStyle}" FontSize="9.5" Foreground="{ThemeResource AppFaintTextBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="11">
                                                        <TextBlock x:Name="BackgroundImagePathText" Style="{StaticResource PageSubtitleTextBlockStyle}" FontSize="13" Text="未使用自訂背景。圖片會鋪滿視窗並自動壓暗，以維持文字可讀。" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Button Content="選擇圖片" Height="32" Padding="14,0" CornerRadius="9" Background="{ThemeResource AppSunkenBrush}" Click="ChooseBackgroundImageClicked" />
                                                            <Button Content="清除背景" Height="32" Padding="14,0" CornerRadius="9" Background="Transparent" Foreground="{ThemeResource AppMutedTextBrush}" Click="ClearBackgroundImageClicked" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Border
                                x:Name="SettingsSavePanel"
                                Grid.Row="2"
                                Padding="34,14"
                                Background="{ThemeResource AppSunkenBrush}"
                                BorderBrush="{ThemeResource AppBorderBrush}"
                                BorderThickness="0,1,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <Button Content="儲存設定" Height="38" Padding="22,0" Style="{StaticResource PrimaryActionButtonStyle}" Click="SaveSettingsClicked" />
                                    <TextBlock
                                        x:Name="SettingsDirtyText"
                                        VerticalAlignment="Center"
                                        FontSize="12.5"
                                        Foreground="{ThemeResource AppFaintTextBrush}"
                                        Text="所有變更都已儲存。" />
                                    <TextBlock x:Name="SettingsMessage" VerticalAlignment="Center" FontSize="12.5" Foreground="{ThemeResource AppMutedTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
