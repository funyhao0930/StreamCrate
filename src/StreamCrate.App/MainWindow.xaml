<Window
    x:Class="StreamCrate.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:StreamCrate.App.Presentation"
    Title="StreamCrate">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource AppCanvasBrush}" SizeChanged="RootGridSizeChanged">
        <Image
            x:Name="BackgroundImage"
            ImageFailed="BackgroundImageFailed"
            IsHitTestVisible="False"
            Stretch="UniformToFill"
            Visibility="Collapsed" />
        <Border Background="{ThemeResource AppCanvasBrush}" Opacity="0.88" IsHitTestVisible="False" />
        <Canvas x:Name="AuroraLayer" IsHitTestVisible="False">
            <Ellipse
                x:Name="AuroraOne"
                Width="1360"
                Height="1040"
                Canvas.Left="-526"
                Canvas.Top="-488">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#8C4CC9A7" Offset="0" />
                        <GradientStop Color="#004CC9A7" Offset="0.62" />
                        <GradientStop Color="#004CC9A7" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse
                x:Name="AuroraTwo"
                Width="1400"
                Height="1040"
                Canvas.Left="426"
                Canvas.Top="-424">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#666C56E0" Offset="0" />
                        <GradientStop Color="#006C56E0" Offset="0.62" />
                        <GradientStop Color="#006C56E0" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse
                x:Name="AuroraThree"
                Width="1800"
                Height="1200"
                Canvas.Left="-260"
                Canvas.Top="296">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#424CC9A7" Offset="0" />
                        <GradientStop Color="#004CC9A7" Offset="0.62" />
                        <GradientStop Color="#004CC9A7" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>
        <Border Background="{ThemeResource AppScrimBrush}" IsHitTestVisible="False" />

        <Grid RowDefinitions="48,*">
            <Grid x:Name="AppTitleBar" Height="48" Padding="18,0,0,0" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/StreamCrateMark.png" Width="20" Height="20" Stretch="Uniform" />
                    <TextBlock Text="StreamCrate" Style="{StaticResource AppTitleTextBlockStyle}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="18,0,18,18" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="196" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="SidebarCard"
                    Background="{ThemeResource AppGlassStrongBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20">
                    <Grid RowDefinitions="Auto,*,Auto" Padding="10,14,10,14">
                        <StackPanel x:Name="SidebarHeader" Orientation="Horizontal" Spacing="10" Padding="6,2,6,16">
                            <Border Width="24" Height="24" CornerRadius="7" Background="{ThemeResource AppPrimaryHighlightBrush}">
                                <Image Source="ms-appx:///Assets/StreamCrateMark.png" Stretch="Uniform" Margin="3" />
                            </Border>
                            <TextBlock
                                x:Name="SidebarWordmark"
                                Text="StreamCrate"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource AppDisplayFontFamily}"
                                FontSize="17"
                                Foreground="{ThemeResource AppTextBrush}" />
                        </StackPanel>

                        <Grid Grid.Row="1" VerticalAlignment="Top">
                            <Canvas x:Name="NavIndicatorLayer" IsHitTestVisible="False">
                                <Border
                                    x:Name="NavIndicator"
                                    Height="40"
                                    CornerRadius="12"
                                    Background="{ThemeResource AppNavIndicatorBrush}"
                                    BorderBrush="{ThemeResource AppPrimaryHighlightBrush}"
                                    BorderThickness="1"
                                    Opacity="0" />
                            </Canvas>
                            <StackPanel x:Name="NavItemsPanel" Spacing="3" SizeChanged="NavItemsPanelSizeChanged">
                                <Button Tag="download" Style="{StaticResource NavItemButtonStyle}" Click="NavItemClicked">
                                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE710;" FontSize="14" FontFamily="{StaticResource AppSymbolFontFamily}" />
                                        <TextBlock x:Name="NavDownloadLabel" Grid.Column="1" Text="新增下載" VerticalAlignment="Center" FontSize="13.5" />
                                    </Grid>
                                </Button>
                                <Button Tag="queue" Style="{StaticResource NavItemButtonStyle}" Click="NavItemClicked">
                                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE896;" FontSize="14" FontFamily="{StaticResource AppSymbolFontFamily}" />
                                        <TextBlock x:Name="NavQueueLabel" Grid.Column="1" Text="下載佇列" VerticalAlignment="Center" FontSize="13.5" />
                                        <Border
                                            x:Name="QueueCountBadge"
                                            Grid.Column="2"
                                            MinWidth="20"
                                            Height="18"
                                            CornerRadius="9"
                                            Padding="6,0"
                                            Background="{ThemeResource AppPrimaryBrush}"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                            <TextBlock
                                                x:Name="QueueCountBadgeText"
                                                Text="0"
                                                FontFamily="{StaticResource AppUtilityFontFamily}"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AppOnPrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Button>
                                <Button Tag="history" Style="{StaticResource NavItemButtonStyle}" Click="NavItemClicked">
                                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE81C;" FontSize="14" FontFamily="{StaticResource AppSymbolFontFamily}" />
                                        <TextBlock x:Name="NavHistoryLabel" Grid.Column="1" Text="歷史紀錄" VerticalAlignment="Center" FontSize="13.5" />
                                    </Grid>
                                </Button>
                                <Button Tag="settings" Style="{StaticResource NavItemButtonStyle}" Click="NavItemClicked">
                                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE713;" FontSize="14" FontFamily="{StaticResource AppSymbolFontFamily}" />
                                        <TextBlock x:Name="NavSettingsLabel" Grid.Column="1" Text="設定" VerticalAlignment="Center" FontSize="13.5" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border
                            x:Name="StorageCard"
                            Grid.Row="2"
                            Padding="12,10"
                            Background="{ThemeResource AppSunkenBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="14">
                            <StackPanel Spacing="5">
                                <TextBlock x:Name="StorageCaption" Text="磁碟剩餘" Style="{StaticResource MetricCaptionTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock x:Name="StorageRemainingText" Text="—" FontFamily="{StaticResource AppUtilityFontFamily}" FontSize="18" Foreground="{ThemeResource AppPrimaryBrush}" />
                                    <TextBlock x:Name="StorageUnitText" Text="GB" Margin="0,5,0,0" FontFamily="{StaticResource AppUtilityFontFamily}" FontSize="10" Foreground="{ThemeResource AppFaintTextBrush}" />
                                </StackPanel>
                                <ProgressBar
                                    x:Name="StorageUsageBar"
                                    Margin="0,3,0,0"
                                    Height="4"
                                    CornerRadius="2"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="0"
                                    Foreground="{ThemeResource AppPrimaryBrush}"
                                    Background="{ThemeResource AppProgressTrackBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border
                    x:Name="ContentCard"
                    Grid.Column="1"
                    Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="22">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.Resources>
                            <DataTemplate x:Key="InProgressQueueItemTemplate">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="13"
                                    Background="{ThemeResource AppGlassStrongBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <Border.Transitions>
                                        <TransitionCollection>
                                            <EntranceThemeTransition FromVerticalOffset="24" />
                                        </TransitionCollection>
                                    </Border.Transitions>
                                    <StackPanel>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="44" Height="26" VerticalAlignment="Top" Style="{StaticResource ThumbnailBorderStyle}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" LineHeight="17" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Details}" Margin="0,4,0,0" Style="{StaticResource UtilityTextBlockStyle}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="2"
                                                Content="取消"
                                                Tag="{Binding Id}"
                                                Height="22"
                                                Padding="7,0"
                                                CornerRadius="6"
                                                FontSize="11"
                                                VerticalAlignment="Top"
                                                Background="Transparent"
                                                Foreground="{ThemeResource AppFaintTextBrush}"
                                                Click="CancelJobClicked"
                                                Visibility="{Binding CancelVisibility}" />
                                        </Grid>
                                        <Grid Margin="0,12,0,0" ColumnSpacing="10" Visibility="{Binding ProgressVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Height="5"
                                                CornerRadius="3"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource AppProgressTrackBrush}"
                                                SizeChanged="ProgressTrackSizeChanged">
                                                <Grid>
                                                    <ProgressBar
                                                        Height="5"
                                                        CornerRadius="3"
                                                        Value="{Binding ProgressPercent}"
                                                        Maximum="100"
                                                        Foreground="{ThemeResource AppPrimaryBrush}"
                                                        Background="Transparent" />
                                                    <Rectangle
                                                        Width="72"
                                                        HorizontalAlignment="Left"
                                                        Fill="{ThemeResource AppShimmerSweepBrush}"
                                                        IsHitTestVisible="False"
                                                        Loaded="ProgressShimmerLoaded" />
                                                </Grid>
                                            </Border>
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding ProgressPercentText}"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource AppUtilityFontFamily}"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AppPrimaryBrush}" />
                                        </Grid>
                                        <TextBlock
                                            Text="{Binding ProgressDetails}"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding ProgressDetailsVisibility}"
                                            Style="{StaticResource UtilityTextBlockStyle}"
                                            FontSize="10"
                                            Foreground="{ThemeResource AppFaintTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>

                            <DataTemplate x:Key="CompletedQueueItemTemplate">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="13"
                                    Background="{ThemeResource AppGlassStrongBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <Border.Transitions>
                                        <TransitionCollection>
                                            <EntranceThemeTransition FromVerticalOffset="24" />
                                        </TransitionCollection>
                                    </Border.Transitions>
                                    <Grid ColumnSpacing="11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" VerticalAlignment="Top" CornerRadius="13" Background="{ThemeResource AppPrimaryBrush}">
                                            <FontIcon Glyph="&#xE73E;" FontSize="12" FontFamily="{StaticResource AppSymbolFontFamily}" Foreground="{ThemeResource AppOnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" LineHeight="17" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Details}" Margin="0,4,0,0" Style="{StaticResource UtilityTextBlockStyle}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                            <Button
                                                Content="開啟檔案位置"
                                                Margin="0,9,0,0"
                                                Tag="{Binding OutputPath}"
                                                Style="{StaticResource LinkActionButtonStyle}"
                                                Foreground="{ThemeResource AppSelectedTextBrush}"
                                                Click="OpenQueueFolderClicked" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <DataTemplate x:Key="FailedQueueItemTemplate">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="13"
                                    Background="{ThemeResource AppErrorSoftBrush}"
                                    BorderBrush="{ThemeResource AppErrorBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <Border.Transitions>
                                        <TransitionCollection>
                                            <EntranceThemeTransition FromVerticalOffset="24" />
                                        </TransitionCollection>
                                    </Border.Transitions>
                                    <StackPanel>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" LineHeight="17" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Details}" Margin="0,4,0,0" Style="{StaticResource UtilityTextBlockStyle}" FontSize="10.5" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="1" Glyph="&#xE711;" FontSize="15" FontFamily="{StaticResource AppSymbolFontFamily}" Foreground="{ThemeResource AppErrorBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                        </Grid>
                                        <Border Margin="0,11,0,0" Background="{ThemeResource AppErrorSoftBrush}" BorderBrush="{ThemeResource AppErrorBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="11,10">
                                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="11.5" LineHeight="17" Foreground="{ThemeResource AppErrorTextBrush}" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,11,0,0">
                                            <Button Content="重試" Tag="{Binding Id}" Height="28" Padding="12,0" CornerRadius="8" FontSize="11.5" FontWeight="SemiBold" Background="{ThemeResource AppBorderBrush}" BorderThickness="0" Click="RetryJobClicked" />
                                            <Button Content="複製錯誤訊息" Tag="{Binding ErrorMessage}" Height="28" Padding="12,0" CornerRadius="8" FontSize="11.5" Background="Transparent" Foreground="{ThemeResource AppMutedTextBrush}" Click="CopyJobErrorClicked" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>

                            <DataTemplate x:Key="HistoryEntryTemplate">
                                <Border
                                    Padding="16,13"
                                    Background="{ThemeResource AppSurfaceBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="13">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="52" Height="30" VerticalAlignment="Center" Style="{StaticResource ThumbnailBorderStyle}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Details}" Margin="0,3,0,0" Style="{StaticResource UtilityTextBlockStyle}" FontSize="10.5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SizeText}" VerticalAlignment="Center" FontFamily="{StaticResource AppUtilityFontFamily}" FontSize="11" Foreground="{ThemeResource AppFaintTextBrush}" />
                                            <Button Content="開啟資料夾" Tag="{Binding OutputPath}" Style="{StaticResource SmallActionButtonStyle}" Click="OpenHistoryFolderClicked" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <DataTemplate x:Key="HistoryFailedEntryTemplate">
                                <Border
                                    Padding="16,13"
                                    Background="{ThemeResource AppErrorSoftBrush}"
                                    BorderBrush="{ThemeResource AppErrorBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="13">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="52"
                                            Height="30"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource AppErrorSoftBrush}"
                                            BorderBrush="{ThemeResource AppErrorBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Details}" Margin="0,3,0,0" Style="{StaticResource UtilityTextBlockStyle}" FontSize="10.5" Foreground="{ThemeResource AppErrorTextBrush}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            Content="重新下載"
                                            Tag="{Binding SourceUrl}"
                                            Style="{StaticResource SmallActionButtonStyle}"
                                            BorderBrush="{ThemeResource AppErrorBorderBrush}"
                                            Foreground="{ThemeResource AppErrorTextBrush}"
                                            VerticalAlignment="Center"
                                            Click="RetryHistoryEntryClicked" />
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <presentation:HistoryEntryTemplateSelector
                                x:Key="HistoryEntrySelector"
                                Normal="{StaticResource HistoryEntryTemplate}"
                                Failed="{StaticResource HistoryFailedEntryTemplate}" />

                            <DataTemplate x:Key="HistoryDayGroupTemplate">
                                <StackPanel Margin="0,0,0,22">
                                    <Grid ColumnSpacing="15" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="11" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse
                                            Width="11"
                                            Height="11"
                                            Margin="-26,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource AppFaintTextBrush}"
                                            Visibility="{Binding PastDotVisibility}" />
                                        <Ellipse
                                            Width="11"
                                            Height="11"
                                            Margin="-26,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource AppPrimaryBrush}"
                                            Visibility="{Binding TodayDotVisibility}" />
                                        <TextBlock Grid.Column="1" Margin="-26,0,0,0" Text="{Binding Label}" Style="{StaticResource TimelineDayLabelTextBlockStyle}" VerticalAlignment="Center" />
                                    </Grid>
                                    <ItemsControl
                                        ItemsSource="{Binding Items}"
                                        ItemTemplateSelector="{StaticResource HistoryEntrySelector}">
                                        <ItemsControl.ItemContainerTransitions>
                                            <TransitionCollection>
                                                <EntranceThemeTransition FromHorizontalOffset="44" FromVerticalOffset="0" />
                                            </TransitionCollection>
                                        </ItemsControl.ItemContainerTransitions>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </Grid.Resources>

                        <Grid x:Name="DownloadPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource PageHeaderBorderStyle}">
                                <Grid x:Name="DownloadHeaderGrid" ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="7">
                                        <StackPanel x:Name="DownloadPageTitle" Orientation="Horizontal">
                                            <TextBlock Text="新增下載" Style="{StaticResource PageTitleTextBlockStyle}" />
                                            <TextBlock Text="paste a link" Style="{StaticResource PageAccentTextBlockStyle}" />
                                        </StackPanel>
                                        <TextBlock x:Name="DownloadPageSubtitle" Text="貼上網址、確認內容，再把它送進本機佇列。" Style="{StaticResource PageSubtitleTextBlockStyle}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource QuietPillBorderStyle}" Background="{ThemeResource AppSunkenBrush}" Padding="11,8,14,8" VerticalAlignment="Top" Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <ProgressRing x:Name="ToolProgressRing" Width="15" Height="15" IsActive="True" Foreground="{ThemeResource AppPrimaryBrush}" />
                                            <TextBlock x:Name="ToolStatusText" Text="正在準備下載工具" VerticalAlignment="Center" FontSize="12.5" Foreground="{ThemeResource AppMutedTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <InfoBar x:Name="StatusBar" Grid.Row="1" Margin="34,14,34,0" IsOpen="False" IsClosable="True">
                                <InfoBar.ActionButton>
                                    <Button x:Name="RetryToolsButton" Content="重試" Click="RetryToolsClicked" Visibility="Collapsed" />
                                </InfoBar.ActionButton>
                            </InfoBar>

                            <ScrollViewer Grid.Row="2" Padding="34,26,34,26">
                                <StackPanel Spacing="22">
                                    <Border x:Name="DownloadPrimaryCard" Background="Transparent" BorderThickness="0" Padding="0">
                                        <StackPanel>
                                            <TextBlock Text="NEW DOWNLOAD" Style="{StaticResource SectionLabelTextBlockStyle}" Margin="0,0,0,12" />
                                            <Grid x:Name="UrlRow">
                                                <Border
                                                    x:Name="UrlGlow"
                                                    Margin="-5"
                                                    CornerRadius="18"
                                                    BorderBrush="{ThemeResource AppUrlGlowBrush}"
                                                    BorderThickness="5"
                                                    Opacity="0.5"
                                                    IsHitTestVisible="False" />
                                                <Border
                                                    Height="56"
                                                    CornerRadius="13"
                                                    Background="{ThemeResource AppUrlFieldBrush}"
                                                    BorderBrush="{ThemeResource AppUrlBorderBrush}"
                                                    BorderThickness="1" />
                                                <TextBox
                                                    x:Name="UrlBox"
                                                    Height="56"
                                                    CornerRadius="13"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="18,17,132,0"
                                                    VerticalAlignment="Center"
                                                    VerticalContentAlignment="Top"
                                                    FontFamily="{StaticResource AppUtilityFontFamily}"
                                                    FontSize="14.5"
                                                    PlaceholderText="貼上 http 或 https 網址"
                                                    TextChanged="UrlTextChanged">
                                                    <TextBox.Resources>
                                                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                                    </TextBox.Resources>
                                                </TextBox>
                                                <Button
                                                    x:Name="ProbeButton"
                                                    Content="解析網址"
                                                    MinWidth="104"
                                                    Height="40"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"
                                                    CornerRadius="10"
                                                    Padding="20,0"
                                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                                    Click="ProbeClicked"
                                                    IsEnabled="False" />
                                            </Grid>

                                            <StackPanel x:Name="OptionsPanel" Orientation="Horizontal" Spacing="26" Margin="0,20,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="登入方式" Style="{StaticResource MetricCaptionTextBlockStyle}" FontWeight="SemiBold" Margin="0,0,0,9" />
                                                    <ComboBox x:Name="CookieBox" SelectedIndex="0" Width="168" Style="{StaticResource CompactComboBoxStyle}">
                                                        <ComboBoxItem Content="不使用 Cookie" Tag="none" />
                                                        <ComboBoxItem Content="Chrome（Windows 可能無法解密）" Tag="chrome" />
                                                        <ComboBoxItem Content="Edge（Windows 可能無法解密）" Tag="edge" />
                                                        <ComboBoxItem Content="Firefox" Tag="firefox" />
                                                        <ComboBoxItem Content="cookies.txt（瀏覽器匯出的 Netscape 檔）" Tag="file" />
                                                    </ComboBox>
                                                </StackPanel>
