                                                <TextBlock x:Name="CompletedCountText" Text="0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource UtilityTextBlockStyle}" FontSize="11" Foreground="{ThemeResource AppFaintTextBrush}" />
