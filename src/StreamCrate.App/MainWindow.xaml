<Window
    x:Class="StreamCrate.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StreamCrate.App"
    Title="StreamCrate">
    <NavigationView x:Name="RootNavigation" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" SelectionChanged="NavigationSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="新增下載" Tag="download" Icon="Add" IsSelected="True" />
            <NavigationViewItem Content="下載佇列" Tag="queue" Icon="Download" />
            <NavigationViewItem Content="歷史紀錄" Tag="history" Icon="Clock" />
            <NavigationViewItem Content="設定" Tag="settings" Icon="Setting" />
        </NavigationView.MenuItems>
        <Grid x:Name="ContentRoot" Padding="28" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="PageTitle" Text="新增下載" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="True" Severity="Informational" Title="準備中" Message="首次使用時會下載並驗證 yt-dlp 與 FFmpeg。" />
            <ScrollViewer Grid.Row="2">
                <StackPanel x:Name="PageContent" Spacing="14" Margin="0,12,0,0">
                    <TextBox x:Name="UrlBox" Header="影片或播放清單網址" PlaceholderText="貼上網址" />
                    <ComboBox x:Name="CookieBox" Header="登入 Cookie 來源" SelectedIndex="0">
                        <ComboBoxItem Content="不使用 Cookie" Tag="none" />
                        <ComboBoxItem Content="Chrome" Tag="chrome" />
                        <ComboBoxItem Content="Edge" Tag="edge" />
                        <ComboBoxItem Content="Firefox" Tag="firefox" />
                        <ComboBoxItem Content="cookies.txt（本次）" Tag="file" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox x:Name="FormatBox" Header="格式" SelectedIndex="0" Width="180"><ComboBoxItem Content="MP4" /><ComboBoxItem Content="MP3" /></ComboBox>
                        <ComboBox x:Name="QualityBox" Header="畫質" SelectedIndex="3" Width="180"><ComboBoxItem Content="最佳" /><ComboBoxItem Content="2160p" /><ComboBoxItem Content="1440p" /><ComboBoxItem Content="1080p" /><ComboBoxItem Content="720p" /></ComboBox>
                    </StackPanel>
                    <Button Content="解析網址" HorizontalAlignment="Left" Click="ProbeClicked" />
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" />
                    <Button x:Name="QueueButton" Content="加入下載佇列" HorizontalAlignment="Left" Click="QueueClicked" IsEnabled="False" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</Window>
