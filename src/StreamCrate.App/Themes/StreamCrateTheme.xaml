            <SolidColorBrush x:Key="AppSelectedTextBrush" Color="#0F6552" />
            <SolidColorBrush x:Key="AppNavSelectedTextBrush" Color="#0F6552" />
            <SolidColorBrush x:Key="AppSegmentSelectedBrush" Color="#1F070A0C" />
