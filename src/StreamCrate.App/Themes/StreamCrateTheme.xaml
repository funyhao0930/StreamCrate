            <SolidColorBrush x:Key="AppNavSelectedTextBrush" Color="#AEF0DD" />
            <SolidColorBrush x:Key="AppSegmentSelectedBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#F207231C" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#F207231C" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="AppDisplayFontFamily">Instrument Serif, Noto Serif TC, Microsoft JhengHei UI</FontFamily>
    <FontFamily x:Key="AppBodyFontFamily">Public Sans, Noto Sans TC, Segoe UI Variable Text, Microsoft JhengHei UI</FontFamily>
    <FontFamily x:Key="AppUtilityFontFamily">IBM Plex Mono, Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="AppSymbolFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppDisplayFontFamily}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>
    <Style x:Key="PageAccentTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppDisplayFontFamily}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{ThemeResource AppPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="12,0,0,4" />
    </Style>
    <Style x:Key="AppTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppBodyFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>
    <Style x:Key="PageSubtitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppBodyFontFamily}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{ThemeResource AppMutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SectionLabelTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppUtilityFontFamily}" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="160" />
        <Setter Property="Foreground" Value="{ThemeResource AppPrimaryBrush}" />
    </Style>
    <Style x:Key="UtilityTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppUtilityFontFamily}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{ThemeResource AppMutedTextBrush}" />
    </Style>
    <Style x:Key="MetricValueTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppUtilityFontFamily}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>
    <Style x:Key="DockBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="13" />
    </Style>
    <Style x:Key="QueueColumnBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppControlBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="SettingsGroupBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource AppBodyFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{ThemeResource AppControlBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="13,7" />
    </Style>
    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppBodyFontFamily}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Background" Value="{ThemeResource AppPrimaryBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppOnPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootLayer"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootLayer.Background" Value="{ThemeResource AppPrimaryHoverBrush}" />
                                        <Setter Target="RootLayer.BorderBrush" Value="{ThemeResource AppPrimaryHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootLayer.Background" Value="{ThemeResource AppPrimaryHoverBrush}" />
                                        <Setter Target="RootLayer.BorderBrush" Value="{ThemeResource AppPrimaryHoverBrush}" />
                                        <Setter Target="RootLayer.Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootLayer.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="QuietPillBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppControlBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style x:Key="CompactComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource AppBodyFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{ThemeResource AppControlBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style x:Key="NavItemButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppBodyFontFamily}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{ThemeResource AppMutedTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootLayer"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootLayer.Background" Value="{ThemeResource AppSurfaceSubtleBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootLayer.Background" Value="{ThemeResource AppSurfaceBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootLayer.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NavItemSelectedButtonStyle" TargetType="Button" BasedOn="{StaticResource NavItemButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="LinkActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource AppBodyFontFamily}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource AppPrimaryBrush}" />
