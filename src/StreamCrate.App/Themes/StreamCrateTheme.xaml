            <SolidColorBrush x:Key="AppWarningBrush" Color="#E0663C" />
            <SolidColorBrush x:Key="AppProgressTrackBrush" Color="#18070A0C" />
            <SolidColorBrush x:Key="AppAuroraPrimaryBrush" Color="#244CC9A7" />
            <SolidColorBrush x:Key="AppAuroraSecondaryBrush" Color="#1672B994" />
            <SolidColorBrush x:Key="AppScrimBrush" Color="#3DF7FCFA" />
            <SolidColorBrush x:Key="AppOnPrimaryBrush" Color="#FFFFFF" />
