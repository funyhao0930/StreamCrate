        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="34,28,34,22" />
    </Style>
    <Style x:Key="ThumbnailBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>
</ResourceDictionary>