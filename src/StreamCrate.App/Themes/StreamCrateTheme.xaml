<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppCanvasBrush" Color="#F5F7F9" />
            <SolidColorBrush x:Key="AppNavigationBrush" Color="#EDF1F4" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppSurfaceSubtleBrush" Color="#F0F4F7" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#D7E0E8" />
            <SolidColorBrush x:Key="AppPrimaryBrush" Color="#376FBD" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#18232E" />
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#667481" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#3E8B68" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppCanvasBrush" Color="#111820" />
            <SolidColorBrush x:Key="AppNavigationBrush" Color="#171F28" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#1B2530" />
            <SolidColorBrush x:Key="AppSurfaceSubtleBrush" Color="#202C38" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#35414C" />
            <SolidColorBrush x:Key="AppPrimaryBrush" Color="#6F9FDD" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#EDF4FA" />
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#A9B6C2" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#72B994" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>
    <Style x:Key="PageSubtitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource AppMutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SectionLabelTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{ThemeResource AppMutedTextBrush}" />
    </Style>
    <Style x:Key="DockBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AppPrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="18,10" />
    </Style>
    <Style x:Key="QuietPillBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceSubtleBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
</ResourceDictionary>
