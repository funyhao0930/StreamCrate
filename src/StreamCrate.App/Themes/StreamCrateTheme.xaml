            <SolidColorBrush x:Key="AppPrimaryHoverBrush" Color="#126B58" />
            <SolidColorBrush x:Key="AppPrimaryHighlightBrush" Color="#D617836B" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#1A1A1A" />
