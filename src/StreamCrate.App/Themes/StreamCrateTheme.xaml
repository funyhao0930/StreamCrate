        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="TimelineDayLabelTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppUtilityFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="140" />
        <Setter Property="Foreground" Value="{ThemeResource AppFaintTextBrush}" />
    </Style>
    <Style x:Key="MetricCaptionTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppUtilityFontFamily}" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="CharacterSpacing" Value="140" />
        <Setter Property="Foreground" Value="{ThemeResource AppFaintTextBrush}" />
    </Style>
    <Style x:Key="SegmentedHostBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="SegmentButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppBodyFontFamily}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource AppMutedTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootLayer"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootLayer.Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootLayer.Opacity" Value="0.7" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootLayer.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SegmentAccentSelectedButtonStyle" TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AppPrimaryBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppOnPrimaryBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="SegmentNeutralSelectedButtonStyle" TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AppSegmentSelectedBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="FontFamily" Value="{StaticResource AppUtilityFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
