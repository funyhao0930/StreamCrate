        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppCanvasBrush" Color="#070A0C" />
            <SolidColorBrush x:Key="AppWindowBrush" Color="#F20B0F12" />
            <SolidColorBrush x:Key="AppNavigationBrush" Color="#E607231C" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="AppSurfaceSubtleBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="AppControlBrush" Color="#59000000" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="AppPrimaryBrush" Color="#4CC9A7" />
            <SolidColorBrush x:Key="AppPrimaryHoverBrush" Color="#17836B" />
            <SolidColorBrush x:Key="AppPrimaryHighlightBrush" Color="#294CC9A7" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#E8F0F2" />
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#99E8F0F2" />
            <SolidColorBrush x:Key="AppFaintTextBrush" Color="#70E8F0F2" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#72B994" />
            <SolidColorBrush x:Key="AppErrorBrush" Color="#F27A7E" />
            <SolidColorBrush x:Key="AppErrorSoftBrush" Color="#18F27A7E" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="#E0663C" />
            <SolidColorBrush x:Key="AppProgressTrackBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="AppAuroraPrimaryBrush" Color="#384CC9A7" />
            <SolidColorBrush x:Key="AppAuroraSecondaryBrush" Color="#2072B994" />
            <SolidColorBrush x:Key="AppScrimBrush" Color="#6B070A0C" />
            <SolidColorBrush x:Key="AppOnPrimaryBrush" Color="#07231C" />
            <SolidColorBrush x:Key="AppErrorBorderBrush" Color="#47F27A7E" />
            <SolidColorBrush x:Key="AppErrorTextBrush" Color="#F9B7B9" />
            <SolidColorBrush x:Key="AppShimmerBrush" Color="#59FFFFFF" />
            <SolidColorBrush x:Key="AppTimelineRuleBrush" Color="#1AFFFFFF" />
            <LinearGradientBrush x:Key="AppNavIndicatorBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#474CC9A7" Offset="0" />
                <GradientStop Color="#0F4CC9A7" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AppUrlGlowBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#664CC9A7" Offset="0" />
                <GradientStop Color="#2672B994" Offset="0.5" />
                <GradientStop Color="#664CC9A7" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AppShimmerSweepBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00FFFFFF" Offset="0" />
                <GradientStop Color="#73FFFFFF" Offset="0.5" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="AppGlassStrongBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="AppSunkenBrush" Color="#4D000000" />
            <SolidColorBrush x:Key="AppColumnBrush" Color="#42000000" />
            <SolidColorBrush x:Key="AppUrlFieldBrush" Color="#B804090C" />
            <SolidColorBrush x:Key="AppUrlBorderBrush" Color="#8C4CC9A7" />
            <SolidColorBrush x:Key="AppSelectedSoftBrush" Color="#294CC9A7" />
            <SolidColorBrush x:Key="AppSelectedBorderBrush" Color="#734CC9A7" />
